# ==============================================
# OpenClaw BR - Configuração via .env
# ==============================================

# ============ MODELOS DE IA ============
# Escolha UM (coloque sua API key real)

# Opção 1: Claude (Anthropic) - RECOMENDADO
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXX

# Opção 2: OpenAI (GPT-4o)
# OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXX

# ============ GATEWAY ============
# Token seguro do gateway
# Gere com: openssl rand -hex 32
# IMPORTANTE: Não deixe em branco!
OPENCLAW_GATEWAY_TOKEN=seu_token_super_seguro_aqui_32_chars

# ============ AUTH DA INTERFACE WEB ============
# Senha para login na UI (nginx basic auth - usuário fixo: admin)
# Gere com: openssl rand -base64 16
AUTH_PASSWORD=sua_senha_forte_aqui

# ============ REDE ============
# IP macvlan do servidor (onde o Caddy vai escutar)
# Acesse via: https://SERVER_IP
SERVER_IP=10.41.10.153

# ============ SEGURANÇA DO GATEWAY ============
# Origins permitidas para conectar à Control UI
# Use o mesmo IP/porta do SERVER_IP acima
# HTTPS (porta 443 é omitida) pois o Caddy faz SSL termination
OPENCLAW_CONTROL_UI_ALLOWED_ORIGINS=https://10.41.10.153

# Proxies confiáveis (nginx interno faz proxy para o gateway)
# 127.0.0.1 = nginx embutido no container openclaw-gateway
OPENCLAW_GATEWAY_TRUSTED_PROXIES=127.0.0.1

# ============ CANAIS (Opcional) ============
# Telegram - Seu bot token do @BotFather
TELEGRAM_BOT_TOKEN=

# Discord - Seu bot token do Discord Developer Portal
DISCORD_BOT_TOKEN=

# WhatsApp
# Será configurado via CLI (QR code - não coloque aqui)

# ============ CONFIGURAÇÃO AVANÇADA ============
# Modelo específico (deixe em branco para usar padrão: claude-opus-4-5)
# OPENCLAW_MODEL=anthropic/claude-opus-4-5-20251101

# Nível de logging (debug, info, warn, error)
# OPENCLAW_LOG_LEVEL=info
