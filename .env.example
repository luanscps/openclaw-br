# ==============================================
# OpenClaw - Configuração via .env
# ==============================================

# ============ MODELOS DE IA ============
# Escolha UM (coloque sua API key real)

# Opção 1: Claude (Anthropic) - RECOMENDADO
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXX

# Opção 2: OpenAI (GPT-4o)
# OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXX

# ============ GATEWAY ============
# Token seguro do gateway (gere com: openssl rand -hex 32)
# IMPORTANTE: Não deixe em branco - gere um novo com: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=seu_token_super_seguro_aqui_32_chars

# ============ CANAIS (Opcional) ============
# Telegram - Seu bot token do @BotFather
TELEGRAM_BOT_TOKEN=

# Discord - Seu bot token do Discord Developer Portal
DISCORD_BOT_TOKEN=

# WhatsApp
# Será configurado via CLI (QR code - não coloque aqui)

# ============ CONFIGURAÇÃO AVANÇADA ============
# Modelo específico (deixe em branco para usar padrão)
# OPENCLAW_MODEL=anthropic/claude-opus-4-5

# Nível de logging (debug, info, warn, error)
# OPENCLAW_LOG_LEVEL=info
